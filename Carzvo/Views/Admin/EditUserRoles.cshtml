@model EditUserRolesViewModel
@{
    ViewData["Title"] = "Редактирование ролей пользователя";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-user-cog"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5>Пользователь: @Model.UserName</h5>
                        @if (!string.IsNullOrEmpty(Model.UserFullName))
                        {
                            <p class="text-muted">@Model.UserFullName</p>
                        }
                    </div>

                    <form asp-action="EditUserRoles" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="UserName" />

                        <div class="mb-3">
                            <label class="form-label">Выберите роли:</label>
                            <div class="border p-3 rounded">
                                @foreach (var role in Model.AllRoles)
                                {
                                    var isChecked = Model.CurrentRoles.Contains(role);
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedRoles"
                                               value="@role"
                                               id="role_@role"
                                               @(isChecked ? "checked" : "")>
                                        <label class="form-check-label" for="role_@role">
                                            <span class="badge bg-@GetRoleBadgeColor(role)">@role</span>
                                            @GetRoleDescription(role)
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Внимание:</strong> При выборе роли "Driver" пользователю автоматически
                            будет установлен статус водителя.
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Users" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Назад к списку
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetRoleBadgeColor(string role)
    {
        return role switch
        {
            "Admin" => "danger",
            "Manager" => "warning",
            "Driver" => "success",
            "User" => "info",
            _ => "secondary"
        };
    }

    string GetRoleDescription(string role)
    {
        return role switch
        {
            "Admin" => " - Полный доступ ко всем функциям системы",
            "Manager" => " - Управление заказами и водителями",
            "Driver" => " - Выполнение заказов доставки",
            "User" => " - Создание и отслеживание заказов",
            _ => ""
        };
    }
}