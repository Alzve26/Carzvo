@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Панель администратора";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fas fa-tachometer-alt"></i> @ViewData["Title"]</h1>

    <div class="row">
        <!-- Статистика -->
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-users"></i> Пользователи</h5>
                    <h2 class="card-text">@Model.TotalUsers</h2>
                    <a asp-action="Users" class="btn btn-light btn-sm mt-2">Управление</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-truck"></i> Водители</h5>
                    <h2 class="card-text">@Model.TotalDrivers</h2>
                    <a asp-action="DriverApplications" class="btn btn-light btn-sm mt-2">Заявки</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-box"></i> Доставки</h5>
                    <h2 class="card-text">@Model.TotalShipments</h2>
                    <span class="badge bg-warning">@Model.PendingShipments ожидают</span>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-file-alt"></i> Заявки</h5>
                    <h2 class="card-text">@Model.PendingDriverApplications</h2>
                    <a asp-action="DriverApplications" class="btn btn-light btn-sm mt-2">Рассмотреть</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Быстрые действия -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-bolt"></i> Быстрые действия</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="CreateManager" class="btn btn-primary">
                            <i class="fas fa-user-plus"></i> Создать менеджера
                        </a>
                        <a asp-action="Users" class="btn btn-secondary">
                            <i class="fas fa-user-cog"></i> Управление пользователями
                        </a>
                        <a asp-action="DriverApplications" class="btn btn-warning">
                            <i class="fas fa-file-signature"></i> Заявки водителей
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Последние пользователи -->
    @if (Model.RecentUsers != null && Model.RecentUsers.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5><i class="fas fa-user-clock"></i> Последние регистрации</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Имя</th>
                                        <th>Email</th>
                                        <th>Телефон</th>
                                        <th>Дата регистрации</th>
                                        <th>Статус</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.RecentUsers)
                                    {
                                        <tr>
                                            <td>@user.FullName</td>
                                            <td>@user.Email</td>
                                            <td>@user.PhoneNumber</td>
                                            <td>@user.RegistrationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge bg-@(user.Status == "Активен" ? "success" : "danger")">
                                                    @user.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-action="EditUserRoles" asp-route-id="@user.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-user-cog"></i> Роли
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>