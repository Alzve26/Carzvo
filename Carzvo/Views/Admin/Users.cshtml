@model List<ApplicationUser>
@{
    ViewData["Title"] = "Управление пользователями";
    var userRoles = ViewBag.UserRoles as Dictionary<string, List<string>> ?? new Dictionary<string, List<string>>();
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fas fa-users-cog"></i> @ViewData["Title"]</h1>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Все пользователи: @Model.Count</h5>
                <a asp-action="CreateManager" class="btn btn-success btn-sm">
                    <i class="fas fa-user-plus"></i> Создать менеджера
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Имя</th>
                            <th>Email</th>
                            <th>Телефон</th>
                            <th>Роли</th>
                            <th>Статус водителя</th>
                            <th>Дата регистрации</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var roles = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();

                            <tr>
                                <td>@user.Id.Substring(0, 8)...</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.FullName))
                                    {
                                        @user.FullName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Не указано</span>
                                    }
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                    {
                                        @user.PhoneNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">Не указан</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in roles)
                                    {
                                        <span class="badge bg-@GetRoleBadgeColor(role) me-1">@role</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsDriver)
                                    {
                                        <span class="badge bg-success">Да</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Нет</span>
                                    }
                                </td>
                                <td>@user.RegistrationDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="EditUserRoles" asp-route-id="@user.Id"
                                           class="btn btn-outline-primary" title="Редактировать роли">
                                            <i class="fas fa-user-cog"></i>
                                        </a>
                                        @if (user.IsDriver)
                                        {
                                            <button class="btn btn-outline-success" disabled title="Водитель">
                                                <i class="fas fa-truck"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetRoleBadgeColor(string role)
    {
        return role switch
        {
            "Admin" => "danger",
            "Manager" => "warning",
            "Driver" => "success",
            "User" => "info",
            _ => "secondary"
        };
    }
}