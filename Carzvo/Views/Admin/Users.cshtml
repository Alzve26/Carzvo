@model List<ApplicationUser>
@{
    ViewData["Title"] = "Управление пользователями";
    var userRoles = ViewBag.UserRoles as Dictionary<string, List<string>> ?? new Dictionary<string, List<string>>();

    // Получаем параметры из ViewBag (теперь они передаются через контроллер)
    var searchQuery = ViewBag.SearchQuery as string ?? "";
    var roleFilter = ViewBag.RoleFilter as string ?? "";
    var driverFilter = ViewBag.DriverFilter as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "RegistrationDate";
    var sortOrder = ViewBag.SortOrder as string ?? "desc";

    // Доступные роли для фильтра
    var availableRoles = new List<string> { "Admin", "Manager", "Driver", "User" };

    // Статусы водителя
    var driverStatuses = new List<SelectListItem>
    {
        new SelectListItem { Value = "", Text = "Все" },
        new SelectListItem { Value = "true", Text = "Только водители" },
        new SelectListItem { Value = "false", Text = "Не водители" }
    };

    // Скрываем поля ID из таблицы для компактности
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="fas fa-users-cog"></i> @ViewData["Title"]</h1>

    <!-- Панель фильтров и поиска -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Фильтры и поиск</h5>
        </div>
        <div class="card-body">
            <form method="get" id="filterForm" class="row g-3" onsubmit="return validateForm()">
                <!-- Поиск по имени и email -->
                <div class="col-md-4">
                    <label class="form-label">Поиск</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" class="form-control" name="search"
                               placeholder="Имя, email или телефон..."
                               value="@searchQuery"
                               id="searchInput">
                    </div>
                </div>

                <!-- Фильтр по роли -->
                <div class="col-md-3">
                    <label class="form-label">Роль</label>
                    <select class="form-select" name="role" id="roleSelect">
                        <option value="">Все роли</option>
                        @foreach (var role in availableRoles)
                        {
                            <option value="@role" selected="@(roleFilter == role)">@role</option>
                        }
                    </select>
                </div>

                <!-- Фильтр по статусу водителя -->
                <div class="col-md-3">
                    <label class="form-label">Статус водителя</label>
                    <select class="form-select" name="driver" id="driverSelect">
                        @foreach (var status in driverStatuses)
                        {
                            <option value="@status.Value" selected="@(driverFilter == status.Value)">@status.Text</option>
                        }
                    </select>
                </div>

                <!-- Кнопки действий -->
                <div class="col-md-2 d-flex align-items-end">
                    <div class="d-grid gap-2 w-100">
                        <button type="submit" class="btn btn-primary" id="applyFilters">
                            <i class="fas fa-search me-2"></i>Применить
                        </button>
                        <a href="@Url.Action("Users")" class="btn btn-outline-secondary" id="resetFilters">
                            <i class="fas fa-times me-2"></i>Сбросить
                        </a>
                    </div>
                </div>

                <!-- Скрытые поля для сортировки -->
                <input type="hidden" name="sortBy" id="sortByInput" value="@sortBy" />
                <input type="hidden" name="sortOrder" id="sortOrderInput" value="@sortOrder" />
            </form>
        </div>
    </div>

    <!-- Информация о фильтрах -->
    @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(roleFilter) || !string.IsNullOrEmpty(driverFilter))
    {
        <div class="alert alert-info mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Активные фильтры:</strong>
                    @{
                        var filters = new List<string>();
                        if (!string.IsNullOrEmpty(searchQuery))
                            filters.Add($"Поиск: \"{searchQuery}\"");
                        if (!string.IsNullOrEmpty(roleFilter))
                            filters.Add($"Роль: {roleFilter}");
                        if (!string.IsNullOrEmpty(driverFilter))
                            filters.Add(driverFilter == "true" ? "Только водители" : "Не водители");
                    }
                    @string.Join(" • ", filters)
                </div>
                <div>
                    Найдено пользователей: <span class="badge bg-primary">@Model.Count</span>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-users me-2"></i>
                    Пользователи
                    <span class="badge bg-secondary">@Model.Count</span>
                </h5>
                <div>
                    <a asp-action="CreateManager" class="btn btn-success">
                        <i class="fas fa-user-plus me-2"></i>Создать менеджера
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>
                                <a href="javascript:void(0);" onclick="sortTable('FullName')" class="text-decoration-none text-dark">
                                    Имя
                                    @if (sortBy == "FullName")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="javascript:void(0);" onclick="sortTable('Email')" class="text-decoration-none text-dark">
                                    Email
                                    @if (sortBy == "Email")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>Телефон</th>
                            <th>Роли</th>
                            <th>
                                <a href="javascript:void(0);" onclick="sortTable('IsDriver')" class="text-decoration-none text-dark">
                                    Водитель
                                    @if (sortBy == "IsDriver")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="javascript:void(0);" onclick="sortTable('RegistrationDate')" class="text-decoration-none text-dark">
                                    Дата регистрации
                                    @if (sortBy == "RegistrationDate")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-sort"></i>
                                    }
                                </a>
                            </th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                var roles = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-placeholder me-2">
                                                <i class="fas fa-user-circle text-primary fs-4"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">
                                                    @if (!string.IsNullOrEmpty(user.FullName))
                                                    {
                                                        @user.FullName
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Не указано</span>
                                                    }
                                                </div>
                                                <small class="text-muted">@user.UserName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-envelope me-2 text-muted"></i>
                                            <span>@user.Email</span>
                                            @if (!user.EmailConfirmed)
                                            {
                                                <span class="badge bg-warning ms-2" title="Email не подтвержден">
                                                    <i class="fas fa-exclamation-circle"></i>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-phone me-2 text-muted"></i>
                                                <span>@user.PhoneNumber</span>
                                                @if (!user.PhoneNumberConfirmed)
                                                {
                                                    <span class="badge bg-warning ms-2" title="Телефон не подтвержден">
                                                        <i class="fas fa-exclamation-circle"></i>
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Не указан</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var role in roles)
                                            {
                                                <span class="badge bg-@GetRoleBadgeColor(role)">
                                                    @role
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.IsDriver)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-truck me-1"></i>Да
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Нет</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span>@user.RegistrationDate.ToString("dd.MM.yyyy")</span>
                                            <small class="text-muted">@user.RegistrationDate.ToString("HH:mm")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="EditUserRoles" asp-route-id="@user.Id"
                                               class="btn btn-outline-primary" title="Редактировать роли">
                                                <i class="fas fa-user-cog"></i>
                                            </a>
                                            @if (user.IsDriver)
                                            {
                                                <a asp-controller="Shipments" asp-action="DriverShipments" asp-route-driverId="@user.Id"
                                                   class="btn btn-outline-success" title="Заказы водителя">
                                                    <i class="fas fa-truck"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="empty-state">
                                        <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                                        <h4>Пользователи не найдены</h4>
                                        <p class="text-muted">Попробуйте изменить параметры поиска или фильтры</p>
                                        <a href="@Url.Action("Users")" class="btn btn-outline-primary">
                                            <i class="fas fa-times me-2"></i>Сбросить фильтры
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-placeholder {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .empty-state {
            text-align: center;
            padding: 2rem;
        }

        .table th a {
            color: inherit;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .table th a:hover {
            color: #4361ee;
        }

        .badge {
            font-size: 0.85em;
            padding: 0.4em 0.7em;
        }

        /* Стили для модального окна */
        .user-detail-item {
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }

        .user-detail-item:last-child {
            border-bottom: none;
        }

        .user-detail-label {
            font-weight: 600;
            color: #666;
            margin-bottom: 0.25rem;
        }

        .user-detail-value {
            font-size: 1.1em;
        }
    </style>
}

@section Scripts {
    <script>
        // Функция для сортировки таблицы
        function sortTable(sortField) {
            var currentSortBy = $('#sortByInput').val();
            var currentSortOrder = $('#sortOrderInput').val();

            // Определяем новый порядок сортировки
            var newSortOrder = 'desc';
            if (currentSortBy === sortField) {
                newSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
            }

            // Устанавливаем значения сортировки
            $('#sortByInput').val(sortField);
            $('#sortOrderInput').val(newSortOrder);

            // Отправляем форму
            $('#filterForm').submit();
        }

        // Валидация формы (пустая форма = сброс)
        function validateForm() {
            var search = $('#searchInput').val();
            var role = $('#roleSelect').val();
            var driver = $('#driverSelect').val();
            var sortBy = $('#sortByInput').val();
            var sortOrder = $('#sortOrderInput').val();

            // Если все поля пустые и сортировка по умолчанию, просто обновляем страницу
            if (!search && !role && !driver && sortBy === 'RegistrationDate' && sortOrder === 'desc') {
                window.location.href = '@Url.Action("Users")';
                return false;
            }

            return true;
        }

        // Обработка Enter в поле поиска
        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $('#filterForm').submit();
            }
        });

        // Авто-отправка формы при изменении select'ов
        $('#roleSelect, #driverSelect').on('change', function() {
            $('#filterForm').submit();
        });

        // Кнопка сброса
        $('#resetFilters').on('click', function(e) {
            e.preventDefault();
            window.location.href = '@Url.Action("Users")';
        });

        // Показываем индикатор загрузки при отправке формы
        $('#filterForm').on('submit', function() {
            $('#applyFilters').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Загрузка...');
        });

        // Восстанавливаем кнопку если страница загрузилась с ошибкой
        $(document).ready(function() {
            $('#applyFilters').prop('disabled', false).html('<i class="fas fa-search me-2"></i>Применить');
        });
    </script>
}

@functions {
    string GetRoleBadgeColor(string role)
    {
        return role switch
        {
            "Admin" => "danger",
            "Manager" => "warning",
            "Driver" => "success",
            "User" => "info",
            _ => "secondary"
        };
    }
}