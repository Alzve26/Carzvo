@model Carzvo.Models.Shipment
@using Carzvo.Models

@{
    ViewData["Title"] = "Редактирование заказа";
    var drivers = ViewBag.Drivers as List<ApplicationUser> ?? new List<ApplicationUser>();
    var isManagerOrAdmin = User.IsInRole("Manager") || User.IsInRole("Admin");
}

<style>
    .form-card {
        border-radius: 12px;
        border: 1px solid #e0e0e0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

        .form-card .card-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-bottom: 2px solid #dee2e6;
        }

    .info-card {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
    }

    .required::after {
        content: " *";
        color: #dc3545;
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card form-card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>@ViewData["Title"]
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-check-circle fa-lg me-3"></i>
                                <div>
                                    <h5 class="alert-heading mb-1">Успешно!</h5>
                                    <p class="mb-0">@TempData["SuccessMessage"]</p>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-circle fa-lg me-3"></i>
                                <div>
                                    <h5 class="alert-heading mb-1">Ошибка!</h5>
                                    <p class="mb-0">@TempData["ErrorMessage"]</p>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4">
                            <h5 class="alert-heading">Исправьте следующие ошибки:</h5>
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    }

                    <form asp-action="Edit" method="post" id="editForm">
                        <input type="hidden" asp-for="Id" />

                        @if (!isManagerOrAdmin)
                        {
                            <!-- Добавьте эти скрытые поля для обычных пользователей -->
                            <input type="hidden" name="Status" value="@Model.Status" />
                            <input type="hidden" name="DriverId" value="@Model.DriverId" />
                            <input type="hidden" name="Price" value="@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        }
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <!-- Для ОБЫЧНЫХ пользователей -->
                            @if (!isManagerOrAdmin)
                            {
                                <div class="col-md-12 mb-4">
                                    <div class="card info-card">
                                        <div class="card-body">
                                            <h6 class="card-title mb-3">
                                                <i class="fas fa-map-marker-alt me-2"></i>Информация о маршруте
                                            </h6>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <div class="text-muted small">Адрес загрузки</div>
                                                    <div class="fw-medium">@Model.PickupAddress</div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="text-muted small">Адрес доставки</div>
                                                    <div class="fw-medium">@Model.DeliveryAddress</div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <div class="text-muted small">Вес</div>
                                                    <div class="fw-medium">@FormatNumber(Model.Weight) кг</div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="text-muted small">Объем</div>
                                                    <div class="fw-medium">@(Model.Volume > 0 ? FormatNumber(Model.Volume) + " м³" : "Не указан")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Description" class="form-label required">Описание груза</label>
                                        <textarea asp-for="Description" class="form-control" rows="3" required>@Model.Description</textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label asp-for="PickupDate" class="form-label required">Дата загрузки</label>
                                            <input asp-for="PickupDate" class="form-control" type="datetime-local" required
                                                   value="@Model.PickupDate.ToString("yyyy-MM-ddTHH:mm")">
                                            <span asp-validation-for="PickupDate" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label asp-for="DeliveryDate" class="form-label required">Дата доставки</label>
                                            <input asp-for="DeliveryDate" class="form-control" type="datetime-local" required
                                                   value="@Model.DeliveryDate.ToString("yyyy-MM-ddTHH:mm")">
                                            <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Notes" class="form-label">Примечания</label>
                                        <textarea asp-for="Notes" class="form-control" rows="2">@Model.Notes</textarea>
                                        <span asp-validation-for="Notes" class="text-danger"></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Для МЕНЕДЖЕРОВ и АДМИНОВ -->
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="Status" class="form-label required">Статус</label>
                                        <select asp-for="Status" class="form-select" required>
                                            @foreach (var status in Enum.GetValues(typeof(ShipmentStatus)).Cast<ShipmentStatus>())
                                            {
                                                <option value="@status" selected="@(Model.Status == status)">
                                                    @GetStatusDisplayName(status)
                                                </option>
                                            }
                                        </select>
                                        <span asp-validation-for="Status" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="DriverId" class="form-label">Водитель</label>
                                        <select asp-for="DriverId" class="form-select">
                                            <option value="">Выберите водителя</option>
                                            @foreach (var driver in drivers)
                                            {
                                                <option value="@driver.Id" selected="@(Model.DriverId == driver.Id)">
                                                    @driver.FullName (@driver.PhoneNumber)
                                                </option>
                                            }
                                        </select>
                                        <span asp-validation-for="DriverId" class="text-danger"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Price" class="form-label">Цена (₽)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₽</span>
                                            <input type="text" name="Price" class="form-control"
                                                   value="@Model.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                   placeholder="0.00">
                                        </div>
                                        <small class="text-muted">Используйте точку как разделитель: 1500.50</small>
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-8">
                                    <!-- Карточка с информацией о клиенте -->
                                    <div class="card info-card h-100">
                                        <div class="card-body">
                                            <h6 class="card-title mb-3">
                                                <i class="fas fa-user me-2"></i>Информация о клиенте
                                            </h6>

                                            <div class="row">
                                                <div class="col-12 mb-2">
                                                    <div class="text-muted small">Клиент</div>
                                                    <div class="fw-medium">@(Model.User?.FullName ?? "Не указан")</div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-12 mb-2">
                                                    <div class="text-muted small">Телефон</div>
                                                    <div class="fw-medium">@(Model.User?.PhoneNumber ?? "Не указан")</div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-12 mb-2">
                                                    <div class="text-muted small">Email</div>
                                                    <div class="fw-medium">@(Model.User?.Email ?? "Не указан")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Информация о заказе (только чтение) -->
                                <div class="col-md-12 mt-4">
                                    <div class="card info-card">
                                        <div class="card-body">
                                            <h6 class="card-title mb-3">
                                                <i class="fas fa-info-circle me-2"></i>Информация о заказе
                                            </h6>

                                            <div class="row">
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">№ Заказа</div>
                                                    <div class="fw-medium">@Model.OrderNumber</div>
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">Текущий статус</div>
                                                    <div class="fw-medium badge @GetStatusBadgeClass(Model.Status)">
                                                        @GetStatusDisplayName(Model.Status)
                                                    </div>
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">Текущая цена</div>
                                                    <div class="fw-medium">@Model.Price.ToString("N2") ₽</div>
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">Текущий водитель</div>
                                                    <div class="fw-medium">@(Model.Driver?.FullName ?? "Не назначен")</div>
                                                </div>
                                            </div>

                                            <hr class="my-3">

                                            <div class="row">
                                                <div class="col-md-6 mb-2">
                                                    <div class="text-muted small">Адрес загрузки</div>
                                                    <div class="fw-medium">@Model.PickupAddress</div>
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <div class="text-muted small">Адрес доставки</div>
                                                    <div class="fw-medium">@Model.DeliveryAddress</div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">Вес</div>
                                                    <div class="fw-medium">@FormatNumber(Model.Weight) кг</div>
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">Объем</div>
                                                    <div class="fw-medium">@(Model.Volume > 0 ? FormatNumber(Model.Volume) + " м³" : "Не указан")</div>
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">Тип груза</div>
                                                    <div class="fw-medium">@GetCargoTypeDisplayName(Model.CargoType)</div>
                                                </div>
                                                <div class="col-md-3 mb-2">
                                                    <div class="text-muted small">Тип транспорта</div>
                                                    <div class="fw-medium">@GetVehicleTypeDisplayName(Model.VehicleType)</div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-12 mb-2">
                                                    <div class="text-muted small">Описание груза</div>
                                                    <div class="fw-medium">@Model.Description</div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 mb-2">
                                                    <div class="text-muted small">Дата загрузки</div>
                                                    <div class="fw-medium">@Model.PickupDate.ToString("dd.MM.yyyy HH:mm")</div>
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <div class="text-muted small">Дата доставки</div>
                                                    <div class="fw-medium">@Model.DeliveryDate.ToString("dd.MM.yyyy HH:mm")</div>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrEmpty(Model.Notes))
                                            {
                                                <div class="row">
                                                    <div class="col-md-12 mb-2">
                                                        <div class="text-muted small">Примечания</div>
                                                        <div class="fw-medium">@Model.Notes</div>
                                                    </div>
                                                </div>
                                            }

                                            <div class="row">
                                                <div class="col-md-6 mb-2">
                                                    <div class="text-muted small">Дата создания</div>
                                                    <div class="fw-medium">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <div class="text-muted small">Последнее обновление</div>
                                                    <div class="fw-medium">@(Model.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Не обновлялся")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="alert alert-warning mt-4">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Внимание:</strong> @(isManagerOrAdmin ?
                                                        "Вы можете изменить статус, назначить водителя и цену заказа." :
                                                        "Вы можете редактировать только описание, даты и комментарии к заказу.")
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary">
                                <i class="fas fa-boxes me-2"></i>Назад к списку
                            </a>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary" id="saveButton">
                                    <i class="fas fa-save me-2"></i>Сохранить изменения
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Автоматическое скрытие alert через 5 секунд
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Обработка отправки формы
            $('#editForm').submit(function(e) {
                console.log('Отправка формы редактирования...');

                // Проверка дат (только для обычных пользователей)
                @if (!isManagerOrAdmin)
                {
                        @:const pickupDate = new Date($('#PickupDate').val());
                        @:const deliveryDate = new Date($('#DeliveryDate').val());
                        @:
                        @:if (deliveryDate <= pickupDate) {
                        @:    alert('Ошибка: Дата доставки должна быть позже даты загрузки!');
                        @:    e.preventDefault();
                        @:    return false;
                        @:}
                }

                // Показываем индикатор загрузки
                $('#saveButton').html('<i class="fas fa-spinner fa-spin me-2"></i>Сохранение...');
                $('#saveButton').prop('disabled', true);

                return true;
            });

            // Восстанавливаем кнопку если форма не отправляется
            $(window).on('beforeunload', function() {
                $('#saveButton').html('<i class="fas fa-save me-2"></i>Сохранить изменения');
                $('#saveButton').prop('disabled', false);
            });
        });
    </script>
}

@functions {
    // Функция для форматирования чисел
    string FormatNumber(decimal number)
    {
        var str = number.ToString("0.##########");

        if (str.Contains(',') && str.EndsWith(",0"))
        {
            str = str.Substring(0, str.Length - 2);
        }
        else if (str.Contains(',') && str.EndsWith(",00"))
        {
            str = str.Substring(0, str.Length - 3);
        }

        return str;
    }

    string GetStatusBadgeClass(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Pending => "bg-warning text-dark",
            ShipmentStatus.Processing => "bg-info text-white",
            ShipmentStatus.Assigned => "bg-primary text-white",
            ShipmentStatus.InTransit => "bg-info text-white",
            ShipmentStatus.Delivered => "bg-success text-white",
            ShipmentStatus.Cancelled => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    string GetStatusDisplayName(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Pending => "Ожидает",
            ShipmentStatus.Processing => "Обрабатывается",
            ShipmentStatus.Assigned => "Назначен водитель",
            ShipmentStatus.InTransit => "В пути",
            ShipmentStatus.Delivered => "Доставлен",
            ShipmentStatus.Cancelled => "Отменен",
            _ => status.ToString()
        };
    }

    string GetCargoTypeDisplayName(CargoType cargoType)
    {
        if (cargoType == null || cargoType.ToString() == "0" || cargoType.ToString() == "None")
            return "Не указан";

        var name = cargoType.ToString();
        if (string.IsNullOrEmpty(name))
            return "Не указан";

        return name switch
        {
            "General" => "Обычный груз",
            "Standard" => "Стандартный",
            "Fragile" => "Хрупкий",
            "Perishable" => "Скоропортящийся",
            "Dangerous" => "Опасный груз",
            "Hazardous" => "Опасный",
            "Oversized" => "Крупногабаритный",
            "Oversize" => "Крупногабаритный",
            "Large" => "Крупногабаритный",
            "Liquid" => "Жидкость",
            "TemperatureControlled" => "Температурный контроль",
            "Refrigerated" => "Охлаждаемый",
            "Container" => "Контейнерный",
            "Bulk" => "Насыпной",
            "Package" => "Упакованный",
            "Pallets" => "Паллеты",
            "Machinery" => "Оборудование",
            "Equipment" => "Оборудование",
            "Appliances" => "Бытовая техника",
            "Electronics" => "Электроника",
            "Documents" => "Документы",
            "Food" => "Продукты питания",
            "Clothing" => "Одежда",
            "Furniture" => "Мебель",
            "Construction" => "Строительные материалы",
            "Medical" => "Медицинские товары",
            "Chemical" => "Химические вещества",
            "Automotive" => "Автозапчасти",
            "Textile" => "Текстиль",
            "Cosmetics" => "Косметика",
            "Books" => "Книги",
            "Toys" => "Игрушки",
            "Sport" => "Спортивный инвентарь",
            "Music" => "Музыкальное оборудование",
            "Art" => "Произведения искусства",
            "Jewelry" => "Ювелирные изделия",
            "Plants" => "Растения",
            "Animals" => "Животные",
            _ => name
        };
    }

    string GetVehicleTypeDisplayName(VehicleType vehicleType)
    {
        if (vehicleType == null || vehicleType.ToString() == "0" || vehicleType.ToString() == "None")
            return "Не указан";

        var name = vehicleType.ToString();
        if (string.IsNullOrEmpty(name))
            return "Не указан";

        return name switch
        {
            "Truck" => "Грузовик",
            "Van" => "Фургон",
            "Refrigerator" => "Рефрижератор",
            "Refrigerated" => "Рефрижератор",
            "Tanker" => "Цистерна",
            "Container" => "Контейнеровоз",
            "Car" => "Легковой автомобиль",
            "Minivan" => "Минивэн",
            "Pickup" => "Пикап",
            "Trailer" => "Прицеп",
            "Flatbed" => "Платформа",
            "Semi" => "Фура",
            "BoxTruck" => "Бортовой грузовик",
            "Towing" => "Эвакуатор",
            "Motorcycle" => "Мотоцикл",
            "Bicycle" => "Велосипед",
            "Bus" => "Автобус",
            "SUV" => "Внедорожник",
            "Courier" => "Курьерский транспорт",
            "Any" => "Любой",
            "Other" => "Другой",
            "Sedan" => "Седан",
            "Hatchback" => "Хэтчбек",
            "Wagon" => "Универсал",
            "Coupe" => "Купе",
            "Convertible" => "Кабриолет",
            "Crossover" => "Кроссовер",
            "Limousine" => "Лимузин",
            "Tractor" => "Трактор",
            "Excavator" => "Экскаватор",
            "Crane" => "Кран",
            "Forklift" => "Погрузчик",
            "SmallTruck" => "Маленький грузовик",
            "Small Truck" => "Маленький грузовик",
            _ => name
        };
    }
}