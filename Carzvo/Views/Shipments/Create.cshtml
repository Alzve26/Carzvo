@model Carzvo.Models.Shipment
@{
    ViewData["Title"] = "Новый заказ";
}

<!-- ★ ДОБАВЬТЕ ЭТОТ БЛОК ДЛЯ ОШИБОК ★ -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <h5>Ошибки заполнения формы:</h5>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken() <!-- ★ ДОБАВЬТЕ ЭТО ★ -->

                        <div class="row">
                            <!-- Левая колонка -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label">Описание груза *</label>
                                    <textarea asp-for="Description" class="form-control" rows="3"
                                              placeholder="Опишите, что нужно перевезти" required></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>

                                <!-- ★ ДОБАВЛЕНО: CargoType ★ -->
                                <div class="mb-3">
                                    <label asp-for="CargoType" class="form-label">Тип груза *</label>
                                    <select asp-for="CargoType" class="form-select" required>
                                        <option value="">Выберите тип груза</option>
                                        @foreach (Carzvo.Models.CargoType type in Enum.GetValues(typeof(Carzvo.Models.CargoType)))
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CargoType" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="VehicleType" class="form-label">Тип транспорта *</label>
                                    <select asp-for="VehicleType" class="form-select" required>
                                        <option value="">Выберите тип транспорта</option>
                                        @foreach (Carzvo.Models.VehicleType type in Enum.GetValues(typeof(Carzvo.Models.VehicleType)))
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                    <span asp-validation-for="VehicleType" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Правая колонка -->
                            <div class="col-md-6">
                                <!-- ★ ДОБАВЛЕНО: Volume ★ -->
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Weight" class="form-label">Вес *</label>
                                        <div class="input-group">
                                            <input asp-for="Weight" class="form-control" type="number" step="0.1" min="0.1" required>
                                            <span class="input-group-text">кг</span>
                                        </div>
                                        <span asp-validation-for="Weight" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Volume" class="form-label">Объем *</label>
                                        <div class="input-group">
                                            <input asp-for="Volume" class="form-control" type="number" step="0.1" min="0.1" value="1.0" required>
                                            <span class="input-group-text">м³</span>
                                        </div>
                                        <span asp-validation-for="Volume" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="PickupAddress" class="form-label">Адрес загрузки *</label>
                                    <input asp-for="PickupAddress" class="form-control"
                                           placeholder="Откуда забрать груз" required>
                                    <span asp-validation-for="PickupAddress" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="DeliveryAddress" class="form-label">Адрес доставки *</label>
                                    <input asp-for="DeliveryAddress" class="form-control"
                                           placeholder="Куда доставить груз" required>
                                    <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="PickupDate" class="form-label">Дата загрузки *</label>
                                        <input asp-for="PickupDate" class="form-control" type="datetime-local" required>
                                        <span asp-validation-for="PickupDate" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DeliveryDate" class="form-label">Дата доставки *</label>
                                        <input asp-for="DeliveryDate" class="form-control" type="datetime-local" required>
                                        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Notes" class="form-label">Примечания</label>
                                    <textarea asp-for="Notes" class="form-control" rows="2"
                                              placeholder="Особые требования, комментарии..."></textarea>
                                    <span asp-validation-for="Notes" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- ★ ДОБАВЬТЕ СКРЫТОЕ ПОЛЕ ДЛЯ OrderNumber ★ -->
                        <input type="hidden" asp-for="OrderNumber" value="@("ORD-" + DateTime.Now.ToString("yyyyMMddHHmmss"))" />

                        <div class="alert alert-info mt-4">
                            <h5><i class="fas fa-calculator me-2"></i>Расчет стоимости</h5>
                            <p>Стоимость будет рассчитана автоматически на основе:</p>
                            <ul>
                                <li>Типа транспорта</li>
                                <li>Типа и веса груза</li>
                                <li>Объема</li>
                                <li>Срочности доставки</li>
                            </ul>
                            <p class="mb-0"><small>* - обязательные для заполнения поля</small></p>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Назад к списку
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-2"></i>Создать заказ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Автоматическая установка дат
        $(document).ready(function() {
            var now = new Date();
            var tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);
            var dayAfterTomorrow = new Date(tomorrow);
            dayAfterTomorrow.setDate(dayAfterTomorrow.getDate() + 1);

            // Форматирование для datetime-local
            function formatDateTime(date) {
                return date.toISOString().slice(0, 16);
            }

            // Установка значений по умолчанию
            $('#PickupDate').val(formatDateTime(tomorrow));
            $('#DeliveryDate').val(formatDateTime(dayAfterTomorrow));

            // Установка дефолтного Volume
            $('#Volume').val('1.0');

            // Валидация дат
            $('#PickupDate, #DeliveryDate').change(function() {
                var pickup = new Date($('#PickupDate').val());
                var delivery = new Date($('#DeliveryDate').val());

                if (delivery <= pickup) {
                    alert('Дата доставки должна быть позже даты загрузки!');
                    $('#DeliveryDate').val(formatDateTime(new Date(pickup.getTime() + 24 * 60 * 60 * 1000)));
                }
            });
        });
    </script>
}