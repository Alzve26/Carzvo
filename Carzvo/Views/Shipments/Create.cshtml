@model Carzvo.Models.Shipment
@using Carzvo.Models
@{
    ViewData["Title"] = "Новый заказ";
}

<style>
    .form-card {
        border-radius: 12px;
        border: 1px solid #e0e0e0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

        .form-card .card-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-bottom: 2px solid #dee2e6;
        }

    .required-field::after {
        content: " *";
        color: #dc3545;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: none; /* Скрываем по умолчанию */
    }

    .input-validation-error {
        border-color: #dc3545 !important;
    }

    .validation-summary-errors {
        display: none; /* Скрываем сводку ошибок по умолчанию */
    }
</style>

<div class="container mt-4">
    <!-- УБРАНЫ ХЛЕБНЫЕ КРОШКИ - они уже есть в _Layout.cshtml -->

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card form-card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Скрываем общие ошибки - они будут показаны только после submit -->
                    @if (!ViewData.ModelState.IsValid && Context.Request.Method == "POST")
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" id="validationSummary">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-triangle fa-lg me-3"></i>
                                <div>
                                    <h5 class="alert-heading mb-2">Пожалуйста, исправьте следующие ошибки:</h5>
                                    <div asp-validation-summary="All" class="mb-0"></div>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post" id="createForm" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <!-- Левая колонка -->
                            <div class="col-md-6">
                                <!-- Описание груза -->
                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label required-field">Описание груза</label>
                                    <textarea asp-for="Description" class="form-control" rows="3"
                                              placeholder="Опишите, что нужно перевезти"></textarea>
                                    <span asp-validation-for="Description" class="field-validation-error">Пожалуйста, укажите описание груза</span>
                                </div>

                                <!-- Тип груза -->
                                <div class="mb-3">
                                    <label asp-for="CargoType" class="form-label required-field">Тип груза</label>
                                    <select asp-for="CargoType" class="form-select">
                                        <option value="">Выберите тип груза</option>
                                        @foreach (CargoType type in Enum.GetValues(typeof(CargoType)))
                                        {
                                            <option value="@type">@GetCargoTypeDisplayName(type)</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CargoType" class="field-validation-error">Пожалуйста, выберите тип груза</span>
                                </div>

                                <!-- Тип транспорта -->
                                <div class="mb-3">
                                    <label asp-for="VehicleType" class="form-label required-field">Тип транспорта</label>
                                    <select asp-for="VehicleType" class="form-select">
                                        <option value="">Выберите тип транспорта</option>
                                        @foreach (VehicleType type in Enum.GetValues(typeof(VehicleType)))
                                        {
                                            <option value="@type">@GetVehicleTypeDisplayName(type)</option>
                                        }
                                    </select>
                                    <span asp-validation-for="VehicleType" class="field-validation-error">Пожалуйста, выберите тип транспорта</span>
                                </div>
                            </div>

                            <!-- Правая колонка -->
                            <div class="col-md-6">
                                <!-- Вес и объем -->
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Weight" class="form-label required-field">Вес (кг)</label>
                                        <div class="input-group">
                                            <input asp-for="Weight" class="form-control" type="number" step="0.1" min="0.1"
                                                   placeholder="0.1">
                                            <span class="input-group-text">кг</span>
                                        </div>
                                        <span asp-validation-for="Weight" class="field-validation-error">Вес должен быть от 0.1 до 100000 кг</span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Volume" class="form-label required-field">Объем (м³)</label>
                                        <div class="input-group">
                                            <input asp-for="Volume" class="form-control" type="number" step="0.1" min="0.1"
                                                   value="1.0" placeholder="1.0">
                                            <span class="input-group-text">м³</span>
                                        </div>
                                        <span asp-validation-for="Volume" class="field-validation-error">Объем должен быть от 0.1 до 1000 м³</span>
                                    </div>
                                </div>

                                <!-- Адрес загрузки -->
                                <div class="mb-3">
                                    <label asp-for="PickupAddress" class="form-label required-field">Адрес загрузки</label>
                                    <input asp-for="PickupAddress" class="form-control"
                                           placeholder="Введите адрес, откуда забрать груз">
                                    <span asp-validation-for="PickupAddress" class="field-validation-error">Пожалуйста, укажите адрес загрузки</span>
                                </div>

                                <!-- Адрес доставки -->
                                <div class="mb-3">
                                    <label asp-for="DeliveryAddress" class="form-label required-field">Адрес доставки</label>
                                    <input asp-for="DeliveryAddress" class="form-control"
                                           placeholder="Введите адрес, куда доставить груз">
                                    <span asp-validation-for="DeliveryAddress" class="field-validation-error">Пожалуйста, укажите адрес доставки</span>
                                </div>

                                <!-- Даты загрузки и доставки -->
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="PickupDate" class="form-label required-field">Дата загрузки</label>
                                        <input asp-for="PickupDate" class="form-control" type="datetime-local">
                                        <span asp-validation-for="PickupDate" class="field-validation-error">Пожалуйста, укажите дату загрузки</span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DeliveryDate" class="form-label required-field">Дата доставки</label>
                                        <input asp-for="DeliveryDate" class="form-control" type="datetime-local">
                                        <span asp-validation-for="DeliveryDate" class="field-validation-error">Пожалуйста, укажите дату доставки</span>
                                    </div>
                                </div>

                                <!-- Примечания -->
                                <div class="mb-3">
                                    <label asp-for="Notes" class="form-label">Примечания</label>
                                    <textarea asp-for="Notes" class="form-control" rows="2"
                                              placeholder="Особые требования, комментарии..."></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Скрытое поле для номера заказа -->
                        <input type="hidden" asp-for="OrderNumber" value="@("ORD-" + DateTime.Now.ToString("yyyyMMddHHmmss"))" />

                        <!-- Информационный блок -->
                        <div class="alert alert-info mt-4">
                            <h5 class="alert-heading">
                                <i class="fas fa-calculator me-2"></i>Расчет стоимости
                            </h5>
                            <p class="mb-2">Стоимость будет рассчитана автоматически на основе следующих параметров:</p>
                            <ul class="mb-2">
                                <li>Типа транспорта</li>
                                <li>Типа и веса груза</li>
                                <li>Объема груза</li>
                                <li>Срочности доставки</li>
                            </ul>
                            <p class="mb-0"><small>Поля, отмеченные <span class="text-danger">*</span>, обязательны для заполнения</small></p>
                        </div>

                        <!-- Кнопки -->
                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary">
                                <!-- ИЗМЕНЕНО -->
                                <i class="fas fa-boxes me-2"></i>Назад к списку заказов
                            </a >
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary">
                                <i class="fas fa-check me-2"></i>Создать заказ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 1. Устанавливаем минимальную дату - сегодня
            var today = new Date();
            var tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            var dayAfterTomorrow = new Date(tomorrow);
            dayAfterTomorrow.setDate(dayAfterTomorrow.getDate() + 1);

            // Форматирование для datetime-local
            function formatDateTime(date) {
                var year = date.getFullYear();
                var month = ('0' + (date.getMonth() + 1)).slice(-2);
                var day = ('0' + date.getDate()).slice(-2);
                var hours = ('0' + date.getHours()).slice(-2);
                var minutes = ('0' + date.getMinutes()).slice(-2);

                return year + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
            }

            // Установка значений по умолчанию для дат
            $('#PickupDate').val(formatDateTime(tomorrow));
            $('#DeliveryDate').val(formatDateTime(dayAfterTomorrow));

            // 2. Валидация дат - доставка должна быть позже загрузки
            $('#PickupDate, #DeliveryDate').change(function() {
                var pickup = new Date($('#PickupDate').val());
                var delivery = new Date($('#DeliveryDate').val());

                if (delivery <= pickup) {
                    alert('Ошибка: Дата доставки должна быть позже даты загрузки!');
                    // Автоматически устанавливаем дату доставки на 1 день позже
                    var newDeliveryDate = new Date(pickup);
                    newDeliveryDate.setDate(newDeliveryDate.getDate() + 1);
                    $('#DeliveryDate').val(formatDateTime(newDeliveryDate));
                }
            });

            // 3. Кастомная валидация формы при отправке
            $('#createForm').on('submit', function(e) {
                e.preventDefault();

                // Скрываем все предыдущие ошибки
                $('.field-validation-error').hide();
                $('.input-validation-error').removeClass('input-validation-error');
                $('#validationSummary').hide();

                var isValid = true;
                var firstErrorField = null;

                // Проверка обязательных полей
                $('[required]').each(function() {
                    var $field = $(this);
                    var $errorSpan = $field.siblings('.field-validation-error').first();

                    if (!$field.val().trim()) {
                        isValid = false;
                        $field.addClass('input-validation-error');
                        $errorSpan.show();

                        if (!firstErrorField) {
                            firstErrorField = $field;
                        }
                    }
                });

                // Проверка выпадающих списков
                $('select[required]').each(function() {
                    var $select = $(this);
                    var $errorSpan = $select.siblings('.field-validation-error').first();

                    if (!$select.val()) {
                        isValid = false;
                        $select.addClass('input-validation-error');
                        $errorSpan.show();

                        if (!firstErrorField) {
                            firstErrorField = $select;
                        }
                    }
                });

                // Проверка веса
                var weight = parseFloat($('#Weight').val());
                var $weightError = $('#Weight').siblings('.field-validation-error').first();
                if (isNaN(weight) || weight < 0.1 || weight > 100000) {
                    isValid = false;
                    $('#Weight').addClass('input-validation-error');
                    $weightError.show();
                    if (!firstErrorField) firstErrorField = $('#Weight');
                }

                // Проверка объема
                var volume = parseFloat($('#Volume').val());
                var $volumeError = $('#Volume').siblings('.field-validation-error').first();
                if (isNaN(volume) || volume < 0.1 || volume > 1000) {
                    isValid = false;
                    $('#Volume').addClass('input-validation-error');
                    $volumeError.show();
                    if (!firstErrorField) firstErrorField = $('#Volume');
                }

                // Проверка дат
                var pickupDate = $('#PickupDate').val();
                var deliveryDate = $('#DeliveryDate').val();

                if (!pickupDate) {
                    isValid = false;
                    $('#PickupDate').addClass('input-validation-error');
                    $('#PickupDate').siblings('.field-validation-error').first().show();
                    if (!firstErrorField) firstErrorField = $('#PickupDate');
                }

                if (!deliveryDate) {
                    isValid = false;
                    $('#DeliveryDate').addClass('input-validation-error');
                    $('#DeliveryDate').siblings('.field-validation-error').first().show();
                    if (!firstErrorField) firstErrorField = $('#DeliveryDate');
                }

                // Если есть ошибки
                if (!isValid) {
                    // Показываем сводку ошибок
                    $('#validationSummary').show();

                    // Скроллим к первой ошибке
                    if (firstErrorField) {
                        $('html, body').animate({
                            scrollTop: firstErrorField.offset().top - 100
                        }, 500);
                        firstErrorField.focus();
                    }

                    return false;
                }

                // Если все ок - отправляем форму
                $(this).off('submit'); // Убираем обработчик, чтобы форма отправилась
                $(this).submit();
            });

            // 4. Убираем ошибки при вводе данных
            $('input, textarea, select').on('input change', function() {
                var $field = $(this);
                $field.removeClass('input-validation-error');
                $field.siblings('.field-validation-error').first().hide();
            });
        });
    </script>
}

