            _ => cargoType.ToString()
        };
    }

    string GetVehicleTypeDisplayName(VehicleType vehicleType)
    {
        if (vehicleType == null || vehicleType.ToString() == "0" || vehicleType.ToString() == "None")
            return "Не указан";

        var name = vehicleType.ToString().ToLower();
        if (string.IsNullOrEmpty(name))
            return "Не указан";

        return name switch
        {
            "truck" => "Грузовик",
            "van" => "Фургон",
            "refrigerator" => "Рефрижератор",
            "refrigerated" => "Рефрижератор",
            "tanker" => "Цистерна",
            "container" => "Контейнеровоз",
            "car" => "Легковой автомобиль",
            "minivan" => "Минивэн",
            "pickup" => "Пикап",
            "trailer" => "Прицеп",
            "flatbed" => "Платформа",
            "semi" => "Фура",
            "boxtruck" => "Бортовой грузовик",
            "towing" => "Эвакуатор",
            "motorcycle" => "Мотоцикл",
            "bicycle" => "Велосипед",
            "bus" => "Автобус",
            "suv" => "Внедорожник",
            "courier" => "Курьерский транспорт",
            "any" => "Любой",
            "other" => "Другой",
            "sedan" => "Седан",
            "hatchback" => "Хэтчбек",
            "wagon" => "Универсал",
            "coupe" => "Купе",
            "convertible" => "Кабриолет",
            "crossover" => "Кроссовер",
            "limousine" => "Лимузин",
            "tractor" => "Трактор",
            "excavator" => "Экскаватор",
            "crane" => "Кран",
            "forklift" => "Погрузчик",
            "smalltruck" => "Маленький грузовик",
            "mediumtruck" => "Средний грузовик",
            "largetruck" => "Большой грузовик",
            "small" => "Маленький",
            "medium" => "Средний",
            "large" => "Большой",
            "lighttruck" => "Легкий грузовик",
            "heavytruck" => "Тяжелый грузовик",
            "deliveryvan" => "Доставной фургон",
            "cargovan" => "Грузовой фургон",
            "paneltruck" => "Фургон-панель",
            "dumptruck" => "Самосвал",
            "cementtruck" => "Цементовоз",
            "logistics" => "Логистический",
            "transport" => "Транспорт",
            _ => vehicleType.ToString()
        };
    }

    string GetStatusDisplayName(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Pending => "Ожидает",
            ShipmentStatus.Processing => "Обрабатывается",
            ShipmentStatus.Assigned => "Назначен",
            ShipmentStatus.InTransit => "В пути",
            ShipmentStatus.Delivered => "Доставлен",
            ShipmentStatus.Cancelled => "Отменен",
            _ => status.ToString()
        };
    }

    string GetStatusBadgeClass(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Pending => "bg-secondary",
            ShipmentStatus.Processing => "bg-info",
            ShipmentStatus.Assigned => "bg-primary",
            ShipmentStatus.InTransit => "bg-warning",
            ShipmentStatus.Delivered => "bg-success",
            ShipmentStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-boxes me-2"></i>@ViewData["Title"]
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Новый заказ
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            У вас пока нет заказов. <a asp-action="Create" class="alert-link">Создайте первый заказ</a>.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>№ Заказа</th>
                                <th>Дата создания</th>
                                <th>Тип груза</th>
                                <th>Тип транспорта</th>
                                <th>Вес/Объем</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.OrderNumber</strong>
                                        <div class="small text-muted">
                                            @item.PickupAddress → @item.DeliveryAddress
                                        </div>
                                    </td>
                                    <td>
                                        @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td>
                                        @GetCargoTypeDisplayName(item.CargoType)
                                    </td>
                                    <td>
                                        @GetVehicleTypeDisplayName(item.VehicleType)
                                    </td>
                                    <td>
                                        @FormatNumber(item.Weight) кг / @FormatNumber(item.Volume) м³
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(item.Status)">
                                            @GetStatusDisplayName(item.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <!-- Кнопка просмотра -->
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="action-btn btn-view" data-tooltip="Просмотр">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <!-- Кнопка редактирования -->
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="action-btn btn-edit" data-tooltip="Редактировать">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <!-- Кнопка удаления -->
                                            @if (item.Status == ShipmentStatus.Pending ||
                                                                                item.Status == ShipmentStatus.Processing)
                                            {
                                                <button type="button"
                                                        class="action-btn btn-delete"
                                                        data-tooltip="Удалить"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal-@item.Id">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>

                                        <!-- Модальное окно подтверждения удаления -->
                                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1"
                                             aria-labelledby="deleteModalLabel-@item.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="deleteModalLabel-@item.Id">
                                                            Подтверждение удаления
                                                        </h5>
                                                        <button type="button" class="btn-close"
                                                                data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Вы уверены, что хотите удалить заказ <strong>@item.OrderNumber</strong>?</p>
                                                        <p class="text-danger">
                                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                                            Это действие нельзя отменить.
                                                        </p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary"
                                                                data-bs-dismiss="modal">
                                                            Отмена
                                                        </button>
                                                        <form asp-action="Delete" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <button type="submit" class="btn btn-danger">
                                                                <i class="fas fa-trash me-1"></i>Удалить
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Пагинация (если нужно) -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Навигация по страницам" class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@functions {
    string FormatNumber(decimal number)
    {
        var str = number.ToString("0.##");
        return str;
    }
}