@model IEnumerable<Carzvo.Models.Shipment>
@using Carzvo.Models
@{
    ViewData["Title"] = "Мои заказы";
}

<style>
    /* Стили для кнопок действий */
    .action-buttons {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
    }

        .action-btn i {
            font-size: 14px;
            color: white;
        }

    /* Кнопка просмотра - синяя */
    .btn-view {
        background-color: #3498db;
    }

        .btn-view:hover {
            background-color: #2980b9;
            transform: translateY(-1px);
        }

    /* Кнопка редактирования - оранжевая */
    .btn-edit {
        background-color: #e67e22;
    }

        .btn-edit:hover {
            background-color: #d35400;
            transform: translateY(-1px);
        }

    /* Кнопка удаления - красная */
    .btn-delete {
        background-color: #e74c3c;
    }

        .btn-delete:hover {
            background-color: #c0392b;
            transform: translateY(-1px);
        }

    /* Тултип при наведении */
    .action-btn[data-tooltip] {
        position: relative;
    }

        .action-btn[data-tooltip]::before {
            content: attr(data-tooltip);
            position: absolute;
            bottom: -35px;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(0, 0, 0, 0.9);
            color: white;
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 12px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            z-index: 1000;
            pointer-events: none;
        }

        .action-btn[data-tooltip]::after {
            content: '';
            position: absolute;
            bottom: -25px;
            left: 50%;
            transform: translateX(-50%);
            border: 5px solid transparent;
            border-bottom-color: rgba(0, 0, 0, 0.9);
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            z-index: 1001;
            pointer-events: none;
        }

        .action-btn[data-tooltip]:hover::before,
        .action-btn[data-tooltip]:hover::after {
            opacity: 1;
            visibility: visible;
        }

    /* Стили для таблицы */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.02);
    }

    .table th {
        border-top: none;
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Стили для бейджей статусов */
    .badge {
        padding: 0.35em 0.65em;
        font-size: 0.75em;
        font-weight: 600;
    }
</style>

@functions {
    string GetCargoTypeDisplayName(CargoType cargoType)
    {
        if (cargoType == null || cargoType.ToString() == "0" || cargoType.ToString() == "None")
            return "Не указан";

        var name = cargoType.ToString().ToLower();
        if (string.IsNullOrEmpty(name))
            return "Не указан";

        return name switch
        {
            "general" => "Обычный груз",
            "standard" => "Стандартный",
            "fragile" => "Хрупкий",
            "perishable" => "Скоропортящийся",
            "dangerous" => "Опасный груз",
            "hazardous" => "Опасный",
            "oversized" => "Крупногабаритный",
            "oversize" => "Крупногабаритный",
            "large" => "Крупногабаритный",
            "liquid" => "Жидкость",
            "temperaturecontrolled" => "Температурный контроль",
            "refrigerated" => "Охлаждаемый",
            "container" => "Контейнерный",
            "bulk" => "Насыпной",
            "package" => "Упакованный",
            "pallets" => "Паллеты",
            "machinery" => "Оборудование",
            "equipment" => "Оборудование",
            "appliances" => "Бытовая техника",
            "electronics" => "Электроника",
            "documents" => "Документы",
            "food" => "Продукты питания",
            "clothing" => "Одежда",
            "furniture" => "Мебель",
            "construction" => "Строительные материалы",
            "medical" => "Медицинские товары",
            "chemical" => "Химикаты",
            "chemicals" => "Химикаты",
            "automotive" => "Автозапчасти",
            "textile" => "Текстиль",
            "cosmetics" => "Косметика",
            "books" => "Книги",
            "toys" => "Игрушки",
            "sport" => "Спортивный инвентарь",
            "music" => "Музыкальное оборудование",
            "art" => "Произведения искусства",
            "jewelry" => "Ювелирные изделия",
            "plants" => "Растения",
            "animals" => "Животные",
