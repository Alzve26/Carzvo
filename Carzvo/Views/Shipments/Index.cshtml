@model List<Shipment>
@{
    ViewData["Title"] = "Мои заказы";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-boxes me-2"></i>@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Новый заказ
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="display-4 text-muted mb-3">
                    <i class="fas fa-box-open"></i>
                </div>
                <h4>У вас пока нет заказов</h4>
                <p class="text-muted mb-4">Создайте свой первый заказ прямо сейчас</p>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus me-2"></i>Создать первый заказ
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>№ Заказа</th>
                                <th>Описание</th>
                                <th>Тип транспорта</th>
                                <th>Вес</th>
                                <th>Статус</th>
                                <th>Цена</th>
                                <th>Дата создания</th>
                                <th>Водитель</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shipment in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@shipment.OrderNumber</strong>
                                    </td>
                                    <td>
                                        <small class="text-muted">@shipment.Description</small>
                                    </td>
                                    <td>@shipment.VehicleType</td>
                                    <td>@shipment.Weight кг</td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadgeColor(shipment.Status)">
                                            @shipment.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@shipment.Price.ToString("C")</span>
                                    </td>
                                    <td>@shipment.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (shipment.Driver != null)
                                        {
                                            <small>@shipment.Driver.FullName</small>
                                            <br>
                                            <small class="text-muted">@shipment.Driver.PhoneNumber</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Не назначен</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@shipment.Id"
                                               class="btn btn-outline-info" title="Просмотр">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (shipment.Status == ShipmentStatus.Pending)
                                            {
                                                <a asp-action="Edit" asp-route-id="@shipment.Id"
                                                   class="btn btn-outline-warning" title="Редактировать">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Статистика -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Всего заказов</h5>
                        <h2 class="text-primary">@Model.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h5 class="card-title">В процессе</h5>
                        <h2 class="text-warning">@Model.Count(s => s.Status == ShipmentStatus.InTransit || s.Status == ShipmentStatus.Assigned)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Доставлено</h5>
                        <h2 class="text-success">@Model.Count(s => s.Status == ShipmentStatus.Delivered)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <h5 class="card-title">Общая сумма</h5>
                        <h2 class="text-info">@Model.Sum(s => s.Price).ToString("C")</h2>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string GetStatusBadgeColor(ShipmentStatus status)
    {
        return status switch
        {
            ShipmentStatus.Pending => "warning",
            ShipmentStatus.Processing => "info",
            ShipmentStatus.Assigned => "primary",
            ShipmentStatus.InTransit => "success",
            ShipmentStatus.Delivered => "success",
            ShipmentStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }
}