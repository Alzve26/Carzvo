@model Carzvo.Models.DashboardViewModel
@using Carzvo.Models
@{
    ViewData["Title"] = "Заказы";
    var userName = ViewData["UserName"] as string ?? "Пользователь";
    var userRole = ViewData["UserRole"] as string ?? "Пользователь";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h3 mb-2"><i class="fas fa-boxes me-2"></i>Мои заказы</h1>
                            <p class="text-muted mb-0">
                                <span class="badge bg-primary">@userRole</span>
                                <span class="ms-2">@DateTime.Now.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))</span>
                            </p>
                        </div>
                        <div>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-home me-1"></i> На главную
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsAdminOrManager)
    {
        <!-- Панель для администраторов/менеджеров -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-users me-1"></i> Пользователи</h5>
                        <h2 class="card-text">@Model.TotalUsers</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-truck me-1"></i> Водители</h5>
                        <h2 class="card-text">@Model.TotalDrivers</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-box me-1"></i> Все доставки</h5>
                        <h2 class="card-text">@Model.TotalShipments</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-white bg-warning">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-clock me-1"></i> Ожидают</h5>
                        <h2 class="card-text">@Model.PendingShipments</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Последние доставки -->
        @if (Model.RecentShipments != null && Model.RecentShipments.Any())
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fas fa-history me-2"></i>Последние доставки</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>№ Заказа</th>
                                            <th>Клиент</th>
                                            <th>Адрес доставки</th>
                                            <th>Статус</th>
                                            <th>Цена</th>
                                            <th>Дата создания</th>
                                            <th class="text-center">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var shipment in Model.RecentShipments)
                                        {
                                            <tr>
                                                <td><strong>@shipment.OrderNumber</strong></td>
                                                <td>@(shipment.User?.FullName ?? "Не указан")</td>
                                                <td>
                                                    <div class="max-width-200">
                                                        <small class="text-muted">@shipment.DeliveryAddress</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(shipment.Status)">
                                                        @GetStatusDisplayName(shipment.Status)
                                                    </span>
                                                </td>
                                                <td>
                                                    <strong class="text-success">
                                                        @shipment.Price.ToString("N2") ₽
                                                    </strong>
                                                </td>
                                                <td>@shipment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>
                                                    <div class="d-flex justify-content-center gap-1">
                                                        <!-- Просмотр -->
                                                        <a asp-controller="Shipments" asp-action="Details" asp-route-id="@shipment.Id"
                                                           class="btn btn-info btn-sm d-flex align-items-center" title="Просмотр">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <!-- Изменить -->
                                                        @if (shipment.Status == ShipmentStatus.Pending)
                                                        {
                                                            <a asp-controller="Shipments" asp-action="Edit" asp-route-id="@shipment.Id"
                                                               class="btn btn-warning btn-sm d-flex align-items-center" title="Изменить">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                        }
                                                        <!-- Удалить -->
                                                        @if (shipment.Status == ShipmentStatus.Pending)
                                                        {
                                                            <form asp-controller="Shipments" asp-action="Delete" method="post" style="display: inline;">
                                                                <input type="hidden" name="id" value="@shipment.Id" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-danger btn-sm d-flex align-items-center"
                                                                        title="Удалить"
                                                                        onclick="return confirm('Удалить заказ @shipment.OrderNumber?')">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else if (Model.IsDriver)
    {
        <!-- Панель для водителей -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-truck me-2"></i>Мои рейсы</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.MyShipments != null && Model.MyShipments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>№ Заказа</th>
                                            <th>Описание</th>
                                            <th>Адрес загрузки</th>
                                            <th>Статус</th>
                                            <th>Цена</th>
                                            <th>Дата доставки</th>
                                            <th class="text-center">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var shipment in Model.MyShipments)
                                        {
                                            <tr>
                                                <td><strong>@shipment.OrderNumber</strong></td>
                                                <td>
                                                    <div class="max-width-200">
                                                        <small class="text-muted">@shipment.Description</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="max-width-200">
                                                        <small class="text-muted">@shipment.PickupAddress</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(shipment.Status)">
                                                        @GetStatusDisplayName(shipment.Status)
                                                    </span>
                                                </td>
                                                <td>
                                                    <strong class="text-success">
                                                        @shipment.Price.ToString("N2") ₽
                                                    </strong>
                                                </td>
                                                <td>@shipment.DeliveryDate.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-1 justify-content-center">
                                                        <!-- Просмотр -->
                                                        <a asp-controller="Shipments" asp-action="Details" asp-route-id="@shipment.Id"
                                                           class="btn btn-info btn-sm d-flex align-items-center" title="Просмотр">
                                                            <i class="fas fa-eye"></i>
                                                        </a>

                                                        @if (shipment.Status == ShipmentStatus.Assigned)
                                                        {
                                                            <button type="button" class="btn btn-primary btn-sm d-flex align-items-center update-status-btn" title="В путь"
                                                                    data-id="@shipment.Id" data-status="InTransit">
                                                                <i class="fas fa-play"></i>
                                                            </button>
                                                        }

                                                        @if (shipment.Status == ShipmentStatus.InTransit)
                                                        {
                                                            <button type="button" class="btn btn-success btn-sm d-flex align-items-center update-status-btn" title="Доставлено"
                                                                    data-id="@shipment.Id" data-status="Delivered">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info text-center py-4">
                                <div class="display-4 text-info mb-3">
                                    <i class="fas fa-truck"></i>
                                </div>
                                <h4>У вас пока нет назначенных рейсов</h4>
                                <p class="text-muted">Ожидайте назначения новых доставок</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Панель для обычных пользователей -->
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Мои заказы</h5>
                            <a asp-controller="Shipments" asp-action="Create" class="btn btn-primary d-flex align-items-center">
                                <i class="fas fa-plus me-1"></i>Новый заказ
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.MyShipments != null && Model.MyShipments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>№ Заказа</th>
                                            <th>Описание</th>
                                            <th>Статус</th>
                                            <th>Цена</th>
                                            <th>Дата доставки</th>
                                            <th class="text-center">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var shipment in Model.MyShipments)
                                        {
                                            <tr>
                                                <td><strong>@shipment.OrderNumber</strong></td>
                                                <td>
                                                    <div class="max-width-200">
                                                        <small class="text-muted">@shipment.Description</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(shipment.Status)">
                                                        @GetStatusDisplayName(shipment.Status)
                                                    </span>
                                                </td>
                                                <td>
                                                    <strong class="text-success">
                                                        @shipment.Price.ToString("N2") ₽
                                                    </strong>
                                                </td>
                                                <td>@shipment.DeliveryDate.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-1 justify-content-center">
                                                        <!-- Просмотр -->
                                                        <a asp-controller="Shipments" asp-action="Details" asp-route-id="@shipment.Id"
                                                           class="btn btn-info btn-sm d-flex align-items-center" title="Просмотр">
                                                            <i class="fas fa-eye"></i>
                                                        </a>

                                                        @if (shipment.Status == ShipmentStatus.Pending)
                                                        {
                                                            <!-- Изменить -->
                                                            <a asp-controller="Shipments" asp-action="Edit" asp-route-id="@shipment.Id"
                                                               class="btn btn-warning btn-sm d-flex align-items-center" title="Изменить">
                                                                <i class="fas fa-edit"></i>
                                                            </a>

                                                            <!-- Удалить -->
                                                            <form asp-controller="Shipments" asp-action="Delete" method="post" style="display: inline;">
                                                                <input type="hidden" name="id" value="@shipment.Id" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-danger btn-sm d-flex align-items-center"
                                                                        title="Удалить"
                                                                        onclick="return confirm('Удалить заказ @shipment.OrderNumber?')">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div class="display-4 text-muted mb-3">
                                    <i class="fas fa-box-open"></i>
                                </div>
                                <h4>У вас пока нет заказов</h4>
                                <p class="text-muted mb-4">Создайте свой первый заказ прямо сейчас!</p>
                                <a asp-controller="Shipments" asp-action="Create" class="btn btn-primary btn-lg d-flex align-items-center mx-auto" style="width: fit-content;">
                                    <i class="fas fa-plus me-2"></i>Создать первый заказ
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Статистика -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Статистика</h6>
                    </div>
                    <div class="card-body">
                        @if (Model.MyShipments != null)
                        {
                            int totalOrders = 0;
                            int activeOrders = 0;
                            int deliveredOrders = 0;
                            int pendingOrders = 0;

                            foreach (var shipment in Model.MyShipments)
                            {
                                totalOrders++;

                                switch (shipment.Status)
                                {
                                    case ShipmentStatus.InTransit:
                                    case ShipmentStatus.Assigned:
                                    case ShipmentStatus.Processing:
                                        activeOrders++;
                                        break;
                                    case ShipmentStatus.Delivered:
                                        deliveredOrders++;
                                        break;
                                    case ShipmentStatus.Pending:
                                        pendingOrders++;
                                        break;
                                }
                            }

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Всего заказов:</small>
                                    <span class="badge bg-primary">@totalOrders</span>
                                </div>
                                <h5 class="mb-0">@totalOrders</h5>
                            </div>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Активные:</small>
                                    <span class="badge bg-info">@activeOrders</span>
                                </div>
                                <h5 class="mb-0 text-info">@activeOrders</h5>
                            </div>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Ожидают:</small>
                                    <span class="badge bg-warning">@pendingOrders</span>
                                </div>
                                <h5 class="mb-0 text-warning">@pendingOrders</h5>
                            </div>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Доставлено:</small>
                                    <span class="badge bg-success">@deliveredOrders</span>
                                </div>
                                <h5 class="mb-0 text-success">@deliveredOrders</h5>
                            </div>
                        }
                    </div>
                </div>

                <!-- УДАЛЕН: Блок "Быстрые действия" -->

            </div>
        </div>
    }
</div>

<style>
    .max-width-200 {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .d-flex.gap-1 {
        gap: 0.25rem;
    }

    .d-flex.gap-2 {
        gap: 0.5rem;
    }

    .table th {
        font-weight: 600;
        color: #495057;
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .badge {
        font-size: 0.85em;
        padding: 0.35em 0.65em;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Стили для кнопок с иконками */
    .btn-info {
        background-color: #0dcaf0;
        border-color: #0dcaf0;
        color: white;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
        color: white;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }

        .btn-info:hover, .btn-warning:hover, .btn-danger:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .btn-info:hover {
        background-color: #0b9ed8;
        border-color: #0b9ed8;
    }

    .btn-warning:hover {
        background-color: #e0a800;
        border-color: #d39e00;
    }

    .btn-danger:hover {
        background-color: #c82333;
        border-color: #bd2130;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Обновление статуса для водителей
            $('.update-status-btn').click(function() {
                var shipmentId = $(this).data('id');
                var newStatus = $(this).data('status');
                var statusText = newStatus === 'InTransit' ? 'В пути' : 'Доставлен';

                if (confirm('Вы уверены, что хотите изменить статус заказа на "' + statusText + '"?')) {
                    $.ajax({
                        url: '/Shipments/UpdateStatus/' + shipmentId,
                        type: 'POST',
                        data: {
                            status: newStatus,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Ошибка: ' + response.message);
                            }
                        },
                        error: function() {
                            alert('Произошла ошибка при обновлении статуса');
                        }
                    });
                }
            });

            // Подсказки для кнопок
            $('[title]').tooltip();
        });
    </script>
}

@functions {
    string GetStatusBadgeClass(ShipmentStatus status)
    {
        switch (status)
        {
            case ShipmentStatus.Pending:
                return "bg-warning text-dark";
            case ShipmentStatus.Processing:
                return "bg-info text-white";
            case ShipmentStatus.Assigned:
                return "bg-primary text-white";
            case ShipmentStatus.InTransit:
                return "bg-success text-white";
            case ShipmentStatus.Delivered:
                return "bg-success text-white";
            case ShipmentStatus.Cancelled:
                return "bg-danger text-white";
            default:
                return "bg-secondary text-white";
        }
    }

    string GetStatusDisplayName(ShipmentStatus status)
    {
        switch (status)
        {
            case ShipmentStatus.Pending:
                return "Ожидает";
            case ShipmentStatus.Processing:
                return "Обрабатывается";
            case ShipmentStatus.Assigned:
                return "Назначен водитель";
            case ShipmentStatus.InTransit:
                return "В пути";
            case ShipmentStatus.Delivered:
                return "Доставлен";
            case ShipmentStatus.Cancelled:
                return "Отменен";
            default:
                return status.ToString();
        }
    }
}