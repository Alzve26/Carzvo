@using Microsoft.AspNetCore.Identity
@using Carzvo.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
    var roleName = "Пользователь";

    // Определение роли с приоритетом
    if (roles.Contains("Admin"))
        roleName = "Администратор";
    else if (roles.Contains("Manager"))
        roleName = "Менеджер";
    else if (roles.Contains("Driver") || (user != null && user.IsDriver))
        roleName = "Водитель";

    // Получение инициалов
    var initials = !string.IsNullOrEmpty(user?.FullName)
        ? string.Concat(user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(n => n.FirstOrDefault()))
            .ToUpper()
        : user?.UserName?.FirstOrDefault().ToString().ToUpper() ?? "U";
}

@if (SignInManager.IsSignedIn(User))
{

    <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle"
           id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar me-2 position-relative">
                <span class="avatar-initials">@initials</span>
                <span class="user-status @GetRoleStatusClass(roleName)"></span>
            </div>
            <div class="user-info d-none d-md-block text-start">
                <div class="user-name fw-semibold text-truncate" style="max-width: 150px;">
                    @(user?.FullName ?? user?.UserName ?? User.Identity?.Name)
                </div>
                <div class="user-role small">
                    <span class="badge @GetRoleBadgeClass(roleName)">
                        @roleName
                    </span>
                </div>
            </div>
        </a>

        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2" style="min-width: 240px;">
            <li class="dropdown-header px-3 py-2 mb-2 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="user-avatar me-3 position-relative">
                        <span class="avatar-initials">@initials</span>
                        <span class="user-status @GetRoleStatusClass(roleName)"></span>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-truncate">@(user?.FullName ?? user?.UserName)</div>
                        <small class="text-muted d-block text-truncate">@user?.Email</small>
                        <small class="text-muted">@roleName</small>
                    </div>
                </div>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center rounded-2"
                   asp-controller="Account" asp-action="ChangePassword">
                    <i class="fas fa-key text-warning me-3" style="width: 20px;"></i>
                    <div>Сменить пароль</div>
                </a>
            </li>

            <li>
                <a class="dropdown-item d-flex align-items-center rounded-2"
                   asp-controller="Home" asp-action="Dashboard">
                    <i class="fas fa-boxes text-success me-3" style="width: 20px;"></i>
                    <div>Заказы</div>
                </a>
            </li>

            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a class="dropdown-item d-flex align-items-center rounded-2"
                       asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-crown text-danger me-3" style="width: 20px;"></i>
                        <div>Админ панель</div>
                    </a>
                </li>
            }

            <li><hr class="dropdown-divider my-2"></li>

            <li>
                <form class="px-2" asp-controller="Account" asp-action="Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home")">
                    <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                        <i class="fas fa-sign-out-alt me-2"></i>
                        <span>Выйти из системы</span>
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary d-flex align-items-center"
           asp-controller="Account" asp-action="Register">
            <i class="fas fa-user-plus me-2"></i>
            <span class="d-none d-md-inline">Регистрация</span>
        </a>

        <a class="btn btn-primary d-flex align-items-center"
           asp-controller="Account" asp-action="Login">
            <i class="fas fa-sign-in-alt me-2"></i>
            <span class="d-none d-md-inline">Вход</span>
        </a>
    </div>
}

<style>
    .user-avatar {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 14px;
        position: relative;
        transition: transform 0.3s ease;
    }

    .user-avatar:hover {
        transform: scale(1.05);
    }

    .user-status {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 10px;
        height: 10px;
        border: 2px solid white;
        border-radius: 50%;
    }

    .user-status-admin {
        background-color: #dc3545;
    }

    .user-status-manager {
        background-color: #ffc107;
    }

    .user-status-driver {
        background-color: #198754;
    }

    .user-status-user {
        background-color: #6c757d;
    }

    .dropdown-menu {
        border: none;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15) !important;
        z-index: 1050;
    }

    .dropdown-item {
        padding: 10px 15px;
        border-radius: 8px;
        margin: 2px 0;
        transition: all 0.2s;
        color: #495057;
        text-decoration: none;
    }

    .dropdown-item:hover {
        background-color: rgba(67, 97, 238, 0.1);
        transform: translateX(3px);
        color: #4361ee;
    }

    .dropdown-header {
        background-color: rgba(67, 97, 238, 0.05);
    }

    .badge-admin {
        background-color: #dc3545;
        color: white;
    }

    .badge-manager {
        background-color: #ffc107;
        color: #212529;
    }

    .badge-driver {
        background-color: #198754;
        color: white;
    }

    .badge-user {
        background-color: #6c757d;
        color: white;
    }

    @@media (max-width: 768px) {
        .user-info {
            display: none !important;
        }

        .btn span.d-none.d-md-inline {
            display: none !important;
        }

        .btn i {
            margin-right: 0 !important;
        }

        .btn {
            padding: 0.375rem 0.75rem;
        }
    }
</style>

<script>
    $(document).ready(function() {
        // Закрытие дропдауна при клике на пункт меню
        $('.dropdown-item').on('click', function() {
            var dropdown = $(this).closest('.dropdown');
            var dropdownToggle = dropdown.find('.dropdown-toggle');
            var bootstrapDropdown = bootstrap.Dropdown.getInstance(dropdownToggle[0]);
            if (bootstrapDropdown) {
                bootstrapDropdown.hide();
            }
        });

        // Предотвращение закрытия при клике внутри дропдауна
        $('.dropdown-menu').on('click', function(e) {
            e.stopPropagation();
        });

        // Адаптивное отображение имени пользователя
        function checkScreenSize() {
            if (window.innerWidth <= 768) {
                $('.user-info').addClass('d-none');
            } else {
                $('.user-info').removeClass('d-none');
            }
        }

        checkScreenSize();
        $(window).resize(checkScreenSize);
    });
</script>

@functions {
    string GetRoleBadgeClass(string roleName)
    {
        return roleName switch
        {
            "Администратор" => "badge-admin",
            "Менеджер" => "badge-manager",
            "Водитель" => "badge-driver",
            _ => "badge-user"
        };
    }

    string GetRoleStatusClass(string roleName)
    {
        return roleName switch
        {
            "Администратор" => "user-status-admin",
            "Менеджер" => "user-status-manager",
            "Водитель" => "user-status-driver",
            _ => "user-status-user"
        };
    }
}