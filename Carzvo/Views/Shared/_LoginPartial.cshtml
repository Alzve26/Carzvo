@using Microsoft.AspNetCore.Identity
@using Carzvo.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown">
        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle"
           id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar me-2">
                @{
                    var user = await UserManager.GetUserAsync(User);
                    var initials = user?.FullName?.Split(' ').Take(2)
                    .Select(n => n.FirstOrDefault().ToString().ToUpper())
                    .Aggregate((a, b) => a + b) ?? "U";
                }
                <span class="avatar-initials">@initials</span>
            </div>
            <div class="user-info d-none d-md-block">
                <div class="user-name fw-semibold">@User.Identity?.Name</div>
                <div class="user-role small text-muted">
                    @{
                        var roles = await UserManager.GetRolesAsync(user);
                        var role = roles.FirstOrDefault() ?? "Пользователь";
                    }
                    <i class="fas fa-shield-alt me-1"></i>@role
                </div>
            </div>
        </a>

        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2"
            style="min-width: 220px;">
            <li class="dropdown-header px-3 py-2 mb-2 border-bottom">
                <div class="d-flex align-items-center">
                    <div class="user-avatar me-3">
                        <span class="avatar-initials">@initials</span>
                    </div>
                    <div>
                        <div class="fw-bold">@User.Identity?.Name</div>
                        <small class="text-muted">@user?.Email</small>
                    </div>
                </div>
            </li>

            <li>
                <a class="dropdown-item d-flex align-items-center rounded-2"
                   asp-controller="Account" asp-action="Profile">
                    <i class="fas fa-user-circle text-primary me-3"></i>
                    <div>Мой профиль</div>
                </a>
            </li>

            <li>
                <a class="dropdown-item d-flex align-items-center rounded-2"
                   asp-controller="Account" asp-action="ChangePassword">
                    <i class="fas fa-key text-warning me-3"></i>
                    <div>Сменить пароль</div>
                </a>
            </li>

            <li>
                <a class="dropdown-item d-flex align-items-center rounded-2"
                   asp-controller="Home" asp-action="Dashboard">
                    <i class="fas fa-tachometer-alt text-success me-3"></i>
                    <div>Панель управления</div>
                </a>
            </li>

            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <li>
                    <a class="dropdown-item d-flex align-items-center rounded-2"
                       asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-crown text-danger me-3"></i>
                        <div>Админ панель</div>
                    </a>
                </li>
            }

            <li><hr class="dropdown-divider my-2"></li>

            <li>
                <form class="px-2" asp-controller="Account" asp-action="Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home")">
                    <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                        <i class="fas fa-sign-out-alt me-2"></i>
                        <span>Выйти</span>
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary d-flex align-items-center"
           asp-controller="Account" asp-action="Register">
            <i class="fas fa-user-plus me-2"></i>
            <span class="d-none d-md-inline">Регистрация</span>
        </a>

        <a class="btn btn-primary d-flex align-items-center"
           asp-controller="Account" asp-action="Login">
            <i class="fas fa-sign-in-alt me-2"></i>
            <span class="d-none d-md-inline">Вход</span>
        </a>
    </div>
}

<style>
    .user-avatar {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 14px;
    }

        .user-avatar:hover {
            transform: scale(1.05);
            transition: transform 0.3s ease;
        }

        .user-avatar::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 10px;
            height: 10px;
            background: #28a745;
            border: 2px solid white;
            border-radius: 50%;
        }

    .dropdown-menu {
        border: none;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15) !important;
    }

    .dropdown-item {
        padding: 10px 15px;
        border-radius: 8px;
        margin: 2px 0;
        transition: all 0.2s;
    }

        .dropdown-item:hover {
            background-color: rgba(67, 97, 238, 0.1);
            transform: translateX(3px);
        }

    .mobile-view {
        display: none;
    }
</style>

<script>
    $(document).ready(function() {
        $('.dropdown-item').on('click', function() {
            $('.dropdown-toggle').dropdown('hide');
        });

        // Адаптивность для меню
        if (window.innerWidth <= 768) {
            $('.user-info').addClass('mobile-view');
        }
    });
</script>