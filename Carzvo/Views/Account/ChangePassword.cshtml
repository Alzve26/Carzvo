@model Carzvo.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-white">
                    <h4 class="mb-0"><i class="fas fa-key me-2"></i>@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label">Текущий пароль</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input asp-for="OldPassword" class="form-control" type="password">
                                <button class="btn btn-outline-secondary toggle-password" type="button">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input asp-for="NewPassword" class="form-control" type="password" id="newPassword">
                                <button class="btn btn-outline-secondary toggle-password" type="button">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="progress mt-2" style="height: 5px;">
                                <div class="progress-bar" id="passwordStrength" style="width: 0%"></div>
                            </div>
                            <small class="text-muted" id="passwordHint">Надежность пароля</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-check-circle"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" type="password">
                                <button class="btn btn-outline-secondary toggle-password" type="button">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            <div class="form-text" id="passwordMatch"></div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-2"></i>Изменить пароль
                            </button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <div class="text-center">
                        <a asp-action="Profile" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i>Вернуться в профиль
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            // Показать/скрыть пароль
            $('.toggle-password').on('click', function() {
                var input = $(this).closest('.input-group').find('input');
                var icon = $(this).find('i');

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Проверка сложности пароля
            $('#newPassword').on('input', function() {
                var password = $(this).val();
                var strength = 0;

                if (password.length >= 8) strength += 25;
                if (/[A-Z]/.test(password)) strength += 25;
                if (/[0-9]/.test(password)) strength += 25;
                if (/[^A-Za-z0-9]/.test(password)) strength += 25;

                $('#passwordStrength').width(strength + '%');

                var color = '';
                var hint = '';
                if (strength < 25) {
                    color = 'bg-danger';
                    hint = 'Очень слабый';
                } else if (strength < 50) {
                    color = 'bg-warning';
                    hint = 'Слабый';
                } else if (strength < 75) {
                    color = 'bg-info';
                    hint = 'Средний';
                } else {
                    color = 'bg-success';
                    hint = 'Сильный';
                }

                $('#passwordStrength').removeClass().addClass('progress-bar ' + color);
                $('#passwordHint').text('Надежность пароля: ' + hint);
            });

            // Проверка совпадения паролей
            $('#ConfirmPassword').on('input', function() {
                var newPass = $('#newPassword').val();
                var confirmPass = $(this).val();

                if (!confirmPass) {
                    $('#passwordMatch').text('');
                    return;
                }

                if (newPass === confirmPass) {
                    $('#passwordMatch').html('<i class="fas fa-check-circle text-success"></i> Пароли совпадают');
                } else {
                    $('#passwordMatch').html('<i class="fas fa-times-circle text-danger"></i> Пароли не совпадают');
                }
            });
        });
    </script>
}