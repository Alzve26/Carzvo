@model Carzvo.Controllers.ProfileViewModel
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Уведомления -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow">
                <!-- Заголовок -->
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-user-circle me-2"></i>Мой профиль</h4>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Информация о профиле -->
                        <div class="col-md-6">
                            <h5 class="mb-4"><i class="fas fa-info-circle me-2"></i>Информация о профиле</h5>

                            <div class="mb-3">
                                <label class="form-label text-muted">Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input type="email" class="form-control" value="@Model.Email" readonly>
                                    @if (Model.EmailConfirmed)
                                    {
                                        <span class="input-group-text text-success">
                                            <i class="fas fa-check" title="Email подтвержден"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="input-group-text text-warning">
                                            <i class="fas fa-exclamation-triangle" title="Email не подтвержден"></i>
                                        </span>
                                    }
                                </div>
                            </div>

                            <form asp-action="UpdateProfile" method="post">
                                <div class="mb-3">
                                    <label asp-for="FullName" class="form-label">ФИО</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                                        <input asp-for="FullName" class="form-control" placeholder="Введите ваше ФИО">
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="CompanyName" class="form-label">Компания</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-building"></i></span>
                                        <input asp-for="CompanyName" class="form-control" placeholder="Название компании">
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="PhoneNumber" class="form-label">Телефон</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="+7 (XXX) XXX-XX-XX">
                                        @if (Model.PhoneNumberConfirmed)
                                        {
                                            <span class="input-group-text text-success">
                                                <i class="fas fa-check" title="Телефон подтвержден"></i>
                                            </span>
                                        }
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>Сохранить изменения
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Дополнительная информация -->
                        <div class="col-md-6">
                            <h5 class="mb-4"><i class="fas fa-chart-bar me-2"></i>Статистика аккаунта</h5>

                            <div class="list-group mb-4">
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-user-tag me-2"></i>Роли:</span>
                                    <div>
                                        @foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-primary me-1">@role</span>
                                        }
                                    </div>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-calendar-alt me-2"></i>Дата регистрации:</span>
                                    <span class="fw-medium">@Model.CreatedAt.ToString("dd.MM.yyyy")</span>
                                </div>
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-check-circle me-2"></i>Статус:</span>
                                    <span class="badge bg-success">@Model.Status</span>
                                </div>
                            </div>

                            <!-- Быстрые действия -->
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Быстрые действия</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        <a asp-action="ChangePassword" class="btn btn-warning">
                                            <i class="fas fa-key me-2"></i>Сменить пароль
                                        </a>
                                        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-success">
                                            <i class="fas fa-tachometer-alt me-2"></i>Панель управления
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="Admin" asp-action="Index" class="btn btn-danger">
                                                <i class="fas fa-crown me-2"></i>Админ панель
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            // Маска для телефона
            $('#PhoneNumber').inputmask('+7 (999) 999-99-99');

            // Подтверждение действий
            $('.btn-danger').on('click', function(e) {
                if (!confirm('Вы уверены?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}