@model Carzvo.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Мой профиль";
}

<style>
    .profile-card {
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: none;
        overflow: hidden;
    }

    .profile-header {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        color: white;
        padding: 2rem;
    }

    .profile-body {
        padding: 2.5rem;
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: white;
        border: 5px solid white;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .form-control {
        padding: 0.75rem 1rem;
        border-radius: 10px;
        border: 1px solid #e1e5e9;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: #6a11cb;
            box-shadow: 0 0 0 0.2rem rgba(106, 17, 203, 0.25);
        }

    .btn-save {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 14px rgba(106, 17, 203, 0.25);
        }

    .info-item {
        padding: 0.75rem;
        border-radius: 10px;
        background-color: #f8f9fa;
        margin-bottom: 1rem;
    }

    .info-label {
        font-size: 0.875rem;
        color: #6c757d;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-weight: 500;
        color: #212529;
    }
</style>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <!-- Карточка профиля -->
            <div class="card profile-card mb-4">
                <div class="profile-header text-center">
                    <div class="profile-avatar mx-auto mb-3">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3 class="mb-2">
                        @(Model.FullName ?? "Пользователь")
                    </h3>
                    <p class="mb-0 opacity-75">
                        <i class="fas fa-envelope me-1"></i>@(Model.Email ?? "email@example.com")
                    </p>
                </div>

                <div class="card-body">
                    <!-- Информация о пользователе -->
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-phone me-1"></i>Телефон</div>
                        <div class="info-value">@(Model.PhoneNumber ?? "Не указан")</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-map-marker-alt me-1"></i>Адрес</div>
                        <div class="info-value">@(Model.Address ?? "Не указан")</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-building me-1"></i>Компания</div>
                        <div class="info-value">@(Model.CompanyName ?? "Не указана")</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-calendar-alt me-1"></i>Дата регистрации</div>
                        <div class="info-value">@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</div>
                    </div>
                </div>
            </div>

            <!-- Быстрые действия -->
            <div class="card profile-card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Быстрые действия</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="ChangePassword" class="btn btn-outline-primary">
                            <i class="fas fa-key me-2"></i>Сменить пароль
                        </a>
                        <a asp-controller="Shipments" asp-action="Create" class="btn btn-outline-success">
                            <i class="fas fa-plus me-2"></i>Новый заказ
                        </a>
                        <a asp-controller="Shipments" asp-action="Index" class="btn btn-outline-info">
                            <i class="fas fa-box me-2"></i>Мои заказы
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <!-- Форма редактирования профиля -->
            <div class="card profile-card">
                <div class="profile-header">
                    <h3 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>Редактирование профиля
                    </h3>
                    <p class="mb-0 opacity-75">Обновите информацию о себе</p>
                </div>

                <div class="profile-body">
                    <!-- Сообщения об успехе -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-check-circle fa-lg me-3"></i>
                                <div>
                                    <h5 class="alert-heading mb-1">Успешно!</h5>
                                    <p class="mb-0">@TempData["SuccessMessage"]</p>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                        </div>
                    }

                    <!-- Ошибки валидации -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-triangle fa-lg me-3"></i>
                                <div>
                                    <h5 class="alert-heading mb-2">Ошибки при сохранении:</h5>
                                    <div asp-validation-summary="All" class="mb-0"></div>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <!-- Полное имя -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label fw-bold">
                                    <i class="fas fa-user me-1"></i>Полное имя
                                </label>
                                <input asp-for="FullName" class="form-control"
                                       placeholder="Введите ваше полное имя">
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <!-- Телефон -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">
                                    <i class="fas fa-phone me-1"></i>Телефон
                                </label>
                                <input asp-for="PhoneNumber" class="form-control"
                                       placeholder="+7 (999) 123-45-67">
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email (только для чтения) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-envelope me-1"></i>Email
                            </label>
                            <input type="email" class="form-control bg-light"
                                   value="@Model.Email" readonly>
                            <small class="text-muted">Для изменения email обратитесь к администратору</small>
                        </div>

                        <!-- Адрес -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">
                                <i class="fas fa-map-marker-alt me-1"></i>Адрес
                            </label>
                            <input asp-for="Address" class="form-control"
                                   placeholder="г. Москва, ул. Примерная, д. 1">
                        </div>

                        <!-- Компания -->
                        <div class="mb-4">
                            <label asp-for="CompanyName" class="form-label fw-bold">
                                <i class="fas fa-building me-1"></i>Название компании
                            </label>
                            <input asp-for="CompanyName" class="form-control"
                                   placeholder="ООО 'Рога и копыта'">
                        </div>

                        <!-- Кнопки -->
                        <div class="d-flex justify-content-between">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Назад в кабинет
                            </a>
                            <button type="submit" class="btn btn-save">
                                <i class="fas fa-save me-2"></i>Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Статистика -->
            <div class="row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-box fa-2x text-primary mb-3"></i>
                            <h3 class="mb-2">12</h3>
                            <p class="text-muted small mb-0">Всего заказов</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-check-circle fa-2x text-success mb-3"></i>
                            <h3 class="mb-2">8</h3>
                            <p class="text-muted small mb-0">Доставлено</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-clock fa-2x text-warning mb-3"></i>
                            <h3 class="mb-2">2</h3>
                            <p class="text-muted small mb-0">В обработке</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Автоматически скрываем алерты через 5 секунд
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Автофокус на первое редактируемое поле
            $('#FullName').focus();
        });
    </script>
}