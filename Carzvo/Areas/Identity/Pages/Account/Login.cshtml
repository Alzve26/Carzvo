@page
@model Carzvo.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход в систему";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Carzvo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 20px 0;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }
        .card-header {
            border-radius: 15px 15px 0 0 !important;
            padding: 2rem 1.5rem;
        }
        .card-body {
            padding: 2.5rem;
        }
        .form-control-lg {
            padding: 0.75rem 1rem;
            font-size: 1.1rem;
            border-radius: 10px;
            border: 2px solid #e0e0e0;
            transition: all 0.3s;
        }
        .form-control-lg:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 0.25rem rgba(67, 97, 238, 0.25);
        }
        .btn-lg {
            padding: 0.75rem 1.5rem;
            font-size: 1.1rem;
            border-radius: 10px;
            font-weight: 600;
        }
        .validation-icon {
            display: none;
        }
        .field-validation-error .validation-icon {
            display: inline-block;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card">
                    <div class="card-header bg-primary text-white text-center">
                        <h2 class="mb-2"><i class="fas fa-sign-in-alt me-2"></i>@ViewData["Title"]</h2>
                        <p class="mb-0 opacity-75">Войдите в свой аккаунт для продолжения работы</p>
                    </div>
                    
                    <div class="card-body">
                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4">
                                <i class="fas fa-exclamation-triangle me-2"></i>Пожалуйста, исправьте ошибки
                            </div>

                            <div class="mb-4">
                                <label for="Input_Email" class="form-label fw-semibold">
                                    <i class="fas fa-envelope me-1"></i>Email адрес
                                </label>
                                <input asp-for="Input.Email" class="form-control form-control-lg" 
                                       placeholder="example@domain.com" autocomplete="username" />
                                <i class="fas fa-exclamation-circle me-1 validation-icon"></i>
                                <span class="field-validation-valid text-danger small mt-1 d-block" 
                                      data-valmsg-for="Input.Email" 
                                      data-valmsg-replace="true"></span>
                            </div>

                            <div class="mb-4">
                                <label for="Input_Password" class="form-label fw-semibold">
                                    <i class="fas fa-lock me-1"></i>Пароль
                                </label>
                                <input asp-for="Input.Password" class="form-control form-control-lg" 
                                       placeholder="Введите ваш пароль" autocomplete="current-password" />
                                <i class="fas fa-exclamation-circle me-1 validation-icon"></i>
                                <span class="field-validation-valid text-danger small mt-1 d-block" 
                                      data-valmsg-for="Input.Password" 
                                      data-valmsg-replace="true"></span>
                            </div>

                            <div class="mb-4 form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe">
                                    Запомнить меня
                                </label>
                            </div>

                            <div class="d-grid gap-2 mt-5">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-sign-in-alt me-2"></i>Войти в систему
                                </button>
                            </div>
                        </form>

                        <hr class="my-4">

                        <div class="text-center">
                            <p class="mb-0">
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold text-primary">
                                    <i class="fas fa-user-plus me-1"></i>Зарегистрироваться как новый пользователь
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function() {
            // Показываем иконку валидации при ошибке
            $('.field-validation-error').each(function() {
                $(this).prev('.validation-icon').show();
            });
            
            // Обработчик для клиентской валидации
            $('form').on('blur', 'input', function() {
                var $field = $(this);
                var $errorSpan = $field.nextAll('.field-validation-valid').first();
                var $icon = $field.nextAll('.validation-icon').first();
                
                if ($errorSpan.hasClass('field-validation-error')) {
                    $icon.show();
                } else {
                    $icon.hide();
                }
            });
        });
    </script>
</body>
</html>